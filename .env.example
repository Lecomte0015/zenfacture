# Development Settings
NODE_ENV=development

# ─── Stripe — Paiement & abonnements SaaS (Phase 4.3) ──────────────────────────
# Ces variables VITE_* sont exposées côté client (les price ID Stripe ne sont
# pas sensibles). Récupérez-les depuis https://dashboard.stripe.com/products
# après avoir créé un produit + un prix récurrent (mensuel) pour chaque plan payant.
VITE_STRIPE_PRICE_ID_PRO=price_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_STRIPE_PRICE_ID_ENTREPRISE=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Les variables suivantes NE VONT PAS dans ce fichier .env frontend : ce sont des
# secrets serveur à configurer uniquement via la CLI Supabase, pour les Edge
# Functions create-checkout-session et stripe-webhook. Listées ici à titre de
# documentation :
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...          (clé secrète Stripe — Dashboard > Developers > API keys)
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...        (Dashboard > Developers > Webhooks > votre endpoint > Signing secret)
#   supabase secrets set STRIPE_PRICE_ID_PRO=price_...          (même valeur que VITE_STRIPE_PRICE_ID_PRO)
#   supabase secrets set STRIPE_PRICE_ID_ENTREPRISE=price_...   (même valeur que VITE_STRIPE_PRICE_ID_ENTREPRISE)
#   supabase secrets set APP_URL=https://zenfacture.ch          (déjà utilisé par create-payment-link)
#
# Configuration du webhook dans le Dashboard Stripe (Developers > Webhooks > Add endpoint) :
#   URL       : https://<votre-projet>.supabase.co/functions/v1/stripe-webhook
#   Événements: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
